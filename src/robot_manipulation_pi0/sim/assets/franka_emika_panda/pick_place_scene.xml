<mujoco model="franka_panda_pick_place">
  <include file="mjx_panda.xml"/>

  <option timestep="0.005" iterations="8" ls_iterations="12" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.45 0.65" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="table_checker" builtin="checker" mark="edge" rgb1="0.38 0.29 0.22" rgb2="0.48 0.37 0.28"
      markrgb="0.75 0.7 0.65" width="300" height="300"/>
    <material name="floor_mat" rgba="0.82 0.84 0.86 1"/>
    <material name="table_mat" texture="table_checker" texuniform="true" texrepeat="2 2" reflectance="0.15"/>
    <material name="cube_mat" rgba="0.85 0.18 0.15 1"/>
    <material name="target_mat" rgba="0.1 0.75 0.25 0.5"/>
  </asset>

  <worldbody>
    <light name="overhead" pos="0.2 -0.5 1.8" dir="-0.1 0.3 -1" directional="true"/>
    <camera name="overview" pos="1.2 -1.2 0.9" xyaxes="0.707 0.707 0 -0.35 0.35 0.866"/>
    <geom name="floor" size="2 2 0.05" type="plane" material="floor_mat"/>
    <geom name="table" type="box" pos="0.55 0 0.20" size="0.45 0.45 0.02" material="table_mat"/>

    <body name="object" pos="0.50 0.0 0.245">
      <freejoint name="object_free"/>
      <geom name="cube" type="box" size="0.025 0.025 0.025" material="cube_mat" mass="0.05"/>
      <site name="object_site" pos="0 0 0.035" size="0.012" rgba="0.9 0.2 0.2 1"/>
    </body>

    <body name="target" pos="0.65 0.12 0.222">
      <freejoint name="target_free"/>
      <geom name="target_zone" type="cylinder" size="0.045 0.004" material="target_mat" contype="0" conaffinity="0"/>
      <site name="target_site" pos="0 0 0.015" size="0.014" rgba="0.2 0.9 0.2 1"/>
    </body>
  </worldbody>
</mujoco>
